@*
    Work Session History Modal
    Displays session history for a task with operator details
*@

<!-- Work Session History Modal -->
<div class="modal fade" id="sessionHistoryModal" tabindex="-1" aria-labelledby="sessionHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content history-modal-content">
            <div class="modal-header history-modal-header">
                <h5 class="modal-title history-modal-title" id="sessionHistoryModalLabel">
                    <svg class="history-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Work Session History
                </h5>
                <button type="button" class="btn-close history-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Loading State -->
                <div class="history-loading" id="historyLoading" style="display: none;">
                    <div class="text-center py-4">
                        <div class="loading-spinner mx-auto mb-3"></div>
                        <p class="text-muted">Loading session history...</p>
                    </div>
                </div>

                <!-- Error State -->
                <div class="history-error" id="historyError" style="display: none;">
                    <div class="alert alert-danger" role="alert">
                        <svg class="w-4 h-4 me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span id="historyErrorMessage">Failed to load session history.</span>
                    </div>
                </div>

                <!-- Session History Content -->
                <div class="history-content" id="historyContent">
                    <!-- Task Info Header -->
                    <div class="history-task-info-card">
                        <div class="task-info-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                        <div class="task-info-content">
                            <h6 class="task-info-name" id="historyTaskName">Task Name</h6>
                            <div class="task-info-summary">
                                <span class="history-badge sessions-badge" id="historyTotalSessions">0 Sessions</span>
                                <span class="history-badge time-badge" id="historyTotalTime">0h 0m</span>
                            </div>
                        </div>
                    </div>

                    <!-- Session History Cards -->
                    <div class="history-sessions-container" id="sessionHistoryCards">
                        <!-- Session cards will be populated by JavaScript -->
                    </div>

                    <!-- Empty State -->
                    <div class="empty-state text-center py-5" id="historyEmptyState" style="display: none;">
                        <svg class="w-16 h-16 mx-auto mb-3 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h6 class="text-muted">No Session History</h6>
                        <p class="text-muted mb-0">No work sessions have been recorded for this task yet.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer history-modal-footer">
                <button type="button" class="btn btn-secondary history-close-button" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Time Variance Modal -->
<div class="modal fade" id="timeVarianceModal" tabindex="-1" aria-labelledby="timeVarianceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content variance-modal-content">
            <div class="modal-header variance-modal-header">
                <h5 class="modal-title variance-modal-title" id="timeVarianceModalLabel">
                    <svg class="variance-title-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Time Variance Analysis
                </h5>
                <button type="button" class="btn-close variance-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body variance-modal-body">
                <!-- Loading State -->
                <div class="variance-loading" id="varianceLoading" style="display: none;">
                    <div class="text-center py-4">
                        <div class="loading-spinner mx-auto mb-3"></div>
                        <p class="text-muted">Calculating variance analysis...</p>
                    </div>
                </div>

                <!-- Error State -->
                <div class="variance-error" id="varianceError" style="display: none;">
                    <div class="alert alert-danger" role="alert">
                        <svg class="w-4 h-4 me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span id="varianceErrorMessage">Failed to load variance analysis.</span>
                    </div>
                </div>

                <!-- Variance Content -->
                <div class="variance-content" id="varianceContent">
                    <!-- Estimated Time Card -->
                    <div class="variance-metric-card estimated-card">
                        <div class="variance-metric-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="variance-metric-content">
                            <div class="variance-metric-label">ESTIMATED TIME</div>
                            <div class="variance-metric-value" id="varianceEstimatedTime">5h</div>
                        </div>
                    </div>

                    <!-- Actual Time Card -->
                    <div class="variance-metric-card actual-card">
                        <div class="variance-metric-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="variance-metric-content">
                            <div class="variance-metric-label">ACTUAL TIME</div>
                            <div class="variance-metric-value" id="varianceActualTime">15m</div>
                        </div>
                    </div>

                    <!-- Variance Card -->
                    <div class="variance-metric-card variance-card" id="varianceDifferenceCard">
                        <div class="variance-metric-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                            </svg>
                        </div>
                        <div class="variance-metric-content">
                            <div class="variance-metric-label">VARIANCE</div>
                            <div class="variance-metric-value" id="varianceDifference">-95%</div>
                        </div>
                    </div>

                    <!-- Additional Metrics Row -->
                    <div class="variance-additional-metrics">
                        <div class="variance-metric-small">
                            <div class="metric-small-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="metric-small-content">
                                <div class="metric-small-label">Total Sessions</div>
                                <div class="metric-small-value" id="varianceTotalSessions">0</div>
                            </div>
                        </div>
                        <div class="variance-metric-small">
                            <div class="metric-small-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                </svg>
                            </div>
                            <div class="metric-small-content">
                                <div class="metric-small-label">Avg Session</div>
                                <div class="metric-small-value" id="varianceAvgSession">0m</div>
                            </div>
                        </div>
                    </div>

                    <!-- Performance Analysis -->
                    <div class="variance-analysis-section">
                        <div class="analysis-header">
                            <svg class="analysis-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                            <span class="analysis-title">Performance Analysis</span>
                        </div>
                        <div class="analysis-content">
                            <div class="analysis-indicator" id="varianceIndicator"></div>
                            <div class="analysis-text" id="varianceAnalysisText">
                                Analysis will appear here based on the variance data.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty State -->
                <div class="empty-state text-center py-5" id="varianceEmptyState" style="display: none;">
                    <svg class="w-16 h-16 mx-auto mb-3 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    <h6 class="text-muted">No Variance Data</h6>
                    <p class="text-muted mb-0">Insufficient data to calculate variance analysis.</p>
                </div>
            </div>
            <div class="modal-footer variance-modal-footer">
                <button type="button" class="btn btn-secondary variance-close-button" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
