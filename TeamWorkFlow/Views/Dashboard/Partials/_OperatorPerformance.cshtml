@model List<OperatorPerformanceModel>

<div class="operator-performance-section">
    <div class="section-header">
        <h3 class="section-title">
            <i class="fas fa-users"></i>
            Operator Performance
        </h3>
        <p class="section-description">Individual operator performance analysis and comparison</p>
    </div>

    <!-- Performance Summary -->
    <div class="performance-summary">
        <div class="row">
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="fas fa-trophy"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value">@Model.Count(o => o.IsTopPerformer)</div>
                        <div class="summary-label">Top Performers</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value">@(Model.Any() ? Model.Average(o => o.EfficiencyRating).ToString("F1") : "0")%</div>
                        <div class="summary-label">Team Average</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value">@(Model.Any() ? Model.Average(o => o.AverageCompletionTimeHours).ToString("F1") : "0")h</div>
                        <div class="summary-label">Avg Completion Time</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-value">@Model.Count(o => o.NeedsAttention)</div>
                        <div class="summary-label">Need Attention</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Operator Performance Chart -->
    <div class="performance-chart">
        <h4>Efficiency Comparison</h4>
        <div class="chart-container">
            <canvas id="operator-performance-chart" width="400" height="300"></canvas>
        </div>
    </div>

    <!-- Operator Performance Table -->
    <div class="performance-table">
        <h4>Detailed Performance</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Operator</th>
                        <th>Tasks Completed</th>
                        <th>Efficiency Rating</th>
                        <th>On-Time Rate</th>
                        <th>Avg Time</th>
                        <th>Status</th>
                        <th>Trend</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in Model.OrderBy(o => o.Rank))
                    {
                        <tr class="@(op.IsTopPerformer ? "top-performer" : op.NeedsAttention ? "needs-attention" : "")">
                            <td>
                                <span class="@op.RankClass">@op.Rank</span>
                            </td>
                            <td>
                                <div class="operator-info">
                                    <strong>@op.OperatorName</strong>
                                    <small class="text-muted d-block">@op.OperatorEmail</small>
                                </div>
                            </td>
                            <td>@op.TasksCompleted</td>
                            <td>
                                <span class="@op.EfficiencyClass">@op.EfficiencyRatingFormatted</span>
                            </td>
                            <td>@op.OnTimeRateFormatted</td>
                            <td>@op.AverageCompletionTimeFormatted</td>
                            <td>
                                <span class="badge @(op.IsTopPerformer ? "bg-success" : op.NeedsAttention ? "bg-warning" : "bg-secondary")">
                                    @op.PerformanceStatus
                                </span>
                            </td>
                            <td>
                                <span class="@op.TrendClass">
                                    <i class="@op.TrendIcon"></i>
                                    @op.PerformanceTrendFormatted
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Performance Insights -->
    <div class="performance-insights">
        <div class="row">
            <div class="col-md-6">
                <div class="insight-card">
                    <h5>Top Performer</h5>
                    @{
                        var topPerformer = Model.OrderBy(o => o.Rank).FirstOrDefault();
                    }
                    @if (topPerformer != null)
                    {
                        <div class="top-performer-info">
                            <div class="performer-name">@topPerformer.OperatorName</div>
                            <div class="performer-stats">
                                <span class="stat">@topPerformer.EfficiencyRatingFormatted efficiency</span>
                                <span class="stat">@topPerformer.TasksCompleted tasks completed</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="insight-card">
                    <h5>Team Statistics</h5>
                    <div class="team-stats">
                        <div class="stat-item">
                            <span class="stat-label">Average Efficiency:</span>
                            <span class="stat-value">@(Model.Any() ? Model.Average(o => o.EfficiencyRating).ToString("F1") : "0")%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Average Completion Time:</span>
                            <span class="stat-value">@(Model.Any() ? Model.Average(o => o.AverageCompletionTimeHours).ToString("F1") : "0")h</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Operators Needing Attention:</span>
                            <span class="stat-value">@Model.Count(o => o.NeedsAttention)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof Chart !== 'undefined') {
            initializeOperatorChart();
        }
    });

    function initializeOperatorChart() {
        const ctx = document.getElementById('operator-performance-chart');
        if (ctx) {
            const operators = @Html.Raw(Json.Serialize(Model ?? new List<OperatorPerformanceModel>()));

            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: operators.map(o => o.operatorName),
                    datasets: [{
                        label: 'Efficiency Rating (%)',
                        data: operators.map(o => o.efficiencyRating),
                        backgroundColor: operators.map(o =>
                            o.efficiencyRating >= 85 ? '#28a745' :
                            o.efficiencyRating >= 70 ? '#ffc107' : '#dc3545'
                        ),
                        borderColor: '#dee2e6',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
    }
</script>
