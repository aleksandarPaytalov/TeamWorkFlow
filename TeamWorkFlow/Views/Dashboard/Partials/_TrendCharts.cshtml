        canvasContainer.style.position = 'relative';
        canvasContainer.style.width = '100%';
        canvasContainer.style.height = '400px';
        canvasContainer.style.overflow = 'visible';
        canvasContainer.style.display = 'block';

        // Add the new canvas to the container
        canvasContainer.appendChild(newCanvas);

        // Recreate the chart with new data after a delay
        setTimeout(() => {
            initializeCompletionTrendChart();
            // Ensure positioning is enforced after chart creation
            enforceChartPositioning();
        }, 100);

        return;
    }

    function updateTrendStats(trendData) {
        console.log('Updating trend stats with data:', trendData);

        try {
            // Update the stats in the overview section
            if (trendData && trendData.completionTrendData && Array.isArray(trendData.completionTrendData) && trendData.completionTrendData.length > 0) {
                const completionData = trendData.completionTrendData;
                const currentRate = completionData[completionData.length - 1]?.value || 0;
                const avgRate = completionData.reduce((sum, d) => sum + (d?.value || 0), 0) / completionData.length;

                // Update current rate display in the third stat card
                const currentRateElements = document.querySelectorAll('.trend-stat .stat-value');
                if (currentRateElements.length >= 3) {
                    const currentRateElement = currentRateElements[2]; // Third stat card
                    if (currentRateElement) {
                        currentRateElement.textContent = currentRate.toFixed(1) + '%';
                    }
                }

                // Update summary cards if they exist
                const summaryValues = document.querySelectorAll('.summary-card .summary-item .value');
                summaryValues.forEach((element, index) => {
                    if (element && element.textContent.includes('%')) {
                        switch (index) {
                            case 0: // Current Period
                                element.textContent = currentRate.toFixed(1) + '%';
                                break;
                            case 2: // Average Rate
                                element.textContent = avgRate.toFixed(1) + '%';
                                break;
                        }
                    }
                });

                console.log('Trend stats updated successfully');
            } else {
                console.warn('No valid completion trend data for stats update');
            }
        } catch (error) {
            console.error('Error updating trend stats:', error);
        }
    }

    // Helper functions
    function convertDateToServerFormat(dateString) {
        if (!dateString) return null;

        try {
            // Convert from dd/MM/yyyy to yyyy-MM-dd
            const parts = dateString.split('/');
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
            }
            return dateString;
        } catch (error) {
            console.warn('Error converting date format:', error);
            return dateString;
        }
    }

