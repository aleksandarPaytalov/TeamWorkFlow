@model TrendChartModel

<div class="trend-charts-section">
    <div class="section-header">
        <h3 class="section-title">
            <i class="fas fa-chart-line"></i>
            Completion Trends
        </h3>
        <p class="section-description">Task completion trends based on selected time period</p>
    </div>

    <!-- Simple Controls - Only Refresh Button -->
    <div class="chart-controls">
        <div class="control-group">
            <button id="refresh-trends" class="btn btn-outline-primary">
                <i class="fas fa-sync-alt"></i>
                Refresh
            </button>
        </div>
    </div>

    <!-- Simple Overview Stats -->
    <div class="trend-overview">
        <div class="row">
            <div class="col-md-4">
                <div class="trend-stat">
                    <div class="stat-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value @Model.TrendDirectionClass">
                            <i class="@Model.TrendDirectionIcon"></i>
                            @Model.OverallTrendDirection
                        </div>
                        <div class="stat-label">Overall Trend</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="trend-stat">
                    <div class="stat-icon">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@(Model.CompletionTrendData?.Count ?? 0)</div>
                        <div class="stat-label">Data Points</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="trend-stat">
                    <div class="stat-icon">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-value">@(Model.CompletionTrendData?.LastOrDefault()?.Value.ToString("F1") ?? "0.0")%</div>
                        <div class="stat-label">Current Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Sufficiency Warning -->
    @if (!Model.HasSufficientData)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            @Model.DataSufficiencyWarning
        </div>
    }

    <!-- Main Completion Trend Chart -->
    <div class="main-trend-chart">
        <div class="chart-header">
            <h4>Task Completion Trends</h4>
            <div class="chart-info">
                <span class="chart-period">Based on selected time period</span>
            </div>
        </div>
        <div class="chart-container">
            <div id="chart-loading" class="chart-loading" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Updating chart data...</p>
            </div>
            <canvas id="completion-trend-chart" width="400" height="300" data-chart-type="completion-trend"></canvas>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="trend-summary">
        <div class="row">
            <div class="col-md-6">
                <div class="summary-card">
                    <div class="summary-header">
                        <h5>Completion Summary</h5>
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-item">
                            <span class="label">Current Period:</span>
                            <span class="value">@(Model.CompletionTrendLine?.ProjectedNextValue.ToString("F1") ?? "0.0")%</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Trend Direction:</span>
                            <span class="value @(Model.CompletionTrendLine?.DirectionClass ?? "")">@(Model.CompletionTrendLine?.Direction ?? "Stable")</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Average Rate:</span>
                            <span class="value">@(Model.CompletionTrendData?.Any() == true ? Model.CompletionTrendData.Average(d => d.Value).ToString("F1") : "0.0")%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="summary-card">
                    <div class="summary-header">
                        <h5>Performance Insights</h5>
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <div class="summary-content">
                        <div class="summary-item">
                            <span class="label">Best Period:</span>
                            <span class="value">@(Model.CompletionTrendData?.Any() == true ? Model.CompletionTrendData.Max(d => d.Value).ToString("F1") : "0.0")%</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Lowest Period:</span>
                            <span class="value">@(Model.CompletionTrendData?.Any() == true ? Model.CompletionTrendData.Min(d => d.Value).ToString("F1") : "0.0")%</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Variance:</span>
                            <span class="value">@(Model.CompletionTrendData?.Any() == true && Model.CompletionTrendData.Count > 1 ? (Model.CompletionTrendData.Max(d => d.Value) - Model.CompletionTrendData.Min(d => d.Value)).ToString("F1") : "0.0")%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Insights (Simplified) -->
    @if (Model.KeyInsights?.Any() == true)
    {
        <div class="trend-insights">
            <h4>Key Insights</h4>
            <div class="insights-grid">
                @foreach (var insight in Model.KeyInsights.Take(3))
                {
                    <div class="insight-card @insight.TypeClass">
                        <div class="insight-icon">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="insight-content">
                            <h6>@insight.Title</h6>
                            <p>@insight.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    // Global chart variable
    let completionTrendChart = null;

    // Chart registry to prevent conflicts
    window.chartRegistry = window.chartRegistry || {};

    // Global variable to track chart update failures
    let chartUpdateFailures = 0;
    const MAX_UPDATE_FAILURES = 3;
    let chartUpdateDisabled = false;

    // Function to safely destroy chart
    function safeDestroyChart(chartId) {
        if (window.chartRegistry[chartId]) {
            try {
                window.chartRegistry[chartId].destroy();
                console.log(`Chart ${chartId} destroyed successfully`);
            } catch (error) {
                console.warn(`Error destroying chart ${chartId}:`, error);
            }
            delete window.chartRegistry[chartId];
        }
    }

    // Prevent multiple initializations
    let isInitialized = false;

    document.addEventListener('DOMContentLoaded', function() {
        if (isInitialized) {
            console.log('Completion Trends section already initialized');
            return;
        }

        console.log('Initializing Completion Trends section');
        isInitialized = true;

        // Check if Chart.js is available
        if (typeof Chart !== 'undefined' && typeof window.Chart !== 'undefined') {
            initializeCompletionTrendChart();
            // Enforce positioning after initialization
            setTimeout(() => enforceChartPositioning(), 200);
        } else {
            console.error('Chart.js not available for completion trends');
            // Try to wait for Chart.js to load
            setTimeout(() => {
                if (typeof Chart !== 'undefined' && typeof window.Chart !== 'undefined') {
                    console.log('Chart.js loaded after delay, initializing chart');
                    initializeCompletionTrendChart();
                    // Enforce positioning after delayed initialization
                    setTimeout(() => enforceChartPositioning(), 200);
                } else {
                    console.error('Chart.js still not available after delay');
                }
            }, 1000);
        }

        // Initialize refresh button
        initializeTrendRefreshButton();
    });

    function initializeCompletionTrendChart() {
        const chartElement = document.getElementById('completion-trend-chart');
        if (!chartElement) {
            console.error('Completion trend chart canvas not found');
            return;
        }

        // Aggressive canvas cleanup to prevent Chart.js conflicts

        // First, destroy any Chart.js instances associated with this canvas
        if (chartElement.chart) {
            console.log('Canvas already has a chart, destroying it first');
            try {
                chartElement.chart.destroy();
                delete chartElement.chart;
            } catch (error) {
                console.warn('Error destroying existing chart on canvas:', error);
            }
        }

        // Destroy existing chart if it exists
        safeDestroyChart('completion-trend-chart');
        if (completionTrendChart) {
            console.log('Destroying existing chart');
            try {
                completionTrendChart.destroy();
            } catch (destroyError) {
                console.warn('Error destroying chart:', destroyError);
            }
            completionTrendChart = null;
        }

        // Clear all Chart.js references from the canvas
        if (chartElement._chartjs) {
            delete chartElement._chartjs;
        }

        // Remove any data attributes that Chart.js might have added
        chartElement.removeAttribute('data-chartjs-id');

        // Force clear the canvas context
        const ctx = chartElement.getContext('2d');
        if (ctx) {
            ctx.clearRect(0, 0, chartElement.width, chartElement.height);
            // Reset canvas state
            ctx.save();
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, chartElement.width, chartElement.height);
            ctx.restore();
        }

        // Clear the canvas
        try {
            const ctx = chartElement.getContext('2d');
            if (!ctx) {
                console.error('Could not get 2D context from canvas');
                return;
            }

            // Clear the canvas
            ctx.clearRect(0, 0, chartElement.width, chartElement.height);
        } catch (contextError) {
            console.error('Error getting canvas context:', contextError);
            return;
        }

        try {
            const ctx = chartElement.getContext('2d');

            // Use pending data if available, otherwise use server data
            let completionData;
            if (window.pendingTrendData) {
                completionData = window.pendingTrendData;
                window.pendingTrendData = null; // Clear after use
                console.log('Using pending trend data:', completionData);
            } else {
                completionData = @Html.Raw(Json.Serialize(Model.CompletionTrendData ?? new List<TrendDataPoint>()));
                console.log('Using server trend data:', completionData);
            }

            // Prepare chart data with better error handling
            let labels = [];
            let values = [];

            if (Array.isArray(completionData) && completionData.length > 0) {
                labels = completionData.map(d => {
                    if (d && typeof d === 'object') {
                        return d.label || d.dateFormatted || d.date || 'N/A';
                    }
                    return 'N/A';
                });
                values = completionData.map(d => {
                    if (d && typeof d === 'object') {
                        return d.value || d.completionRate || 0;
                    }
                    return 0;
                });
            }

            if (labels.length === 0) {
                labels.push('No Data');
                values.push(0);
            }

            console.log('Chart initialization - Labels:', labels, 'Values:', values);

            // Ensure Chart.js is available
            if (typeof Chart === 'undefined') {
                console.error('Chart.js is not available');
                return;
            }

            completionTrendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Completion Rate (%)',
                        data: values,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#3b82f6',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: 'rgba(44, 62, 80, 0.95)',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            borderColor: '#3498db',
                            borderWidth: 2,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    return `Completion Rate: ${context.parsed.y.toFixed(1)}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    },
                    animation: {
                        duration: 1000,
                        easing: 'easeOutCubic'
                    }
                }
            });

            // Store reference to chart on canvas element and in registry
            chartElement.chart = completionTrendChart;
            window.chartRegistry['completion-trend-chart'] = completionTrendChart;

            // Also register with dashboard.js system if available
            if (window.charts && typeof window.charts === 'object') {
                window.charts.completionTrend = completionTrendChart;
                window.charts['completion-trend-chart'] = completionTrendChart;
                console.log('Chart registered with dashboard.js system');
            }

            console.log('Completion trend chart initialized successfully');

            // Force canvas dimensions after Chart.js initialization
            setTimeout(() => {
                const canvas = document.getElementById('completion-trend-chart');
                if (canvas) {
                    console.log('Forcing canvas dimensions after Chart.js init...');
                    canvas.style.setProperty('width', '100%', 'important');
                    canvas.style.setProperty('height', '360px', 'important');
                    canvas.style.setProperty('max-width', '100%', 'important');
                    canvas.style.setProperty('max-height', '360px', 'important');
                    canvas.style.setProperty('min-height', '360px', 'important');
                    canvas.width = 800;
                    canvas.height = 360;
                    console.log('Canvas dimensions forced. New height:', canvas.style.height);

                    // Trigger chart resize if possible
                    if (completionTrendChart && typeof completionTrendChart.resize === 'function') {
                        completionTrendChart.resize();
                        console.log('Chart resized');
                    }
                }
            }, 100);

        } catch (error) {
            console.error('Error initializing completion trend chart:', error);
        }
    }

    function initializeTrendRefreshButton() {
        const refreshButton = document.getElementById('refresh-trends');
        if (refreshButton) {
            console.log('Trend refresh button found, adding event listener');

            // Remove any existing event listeners
            const newButton = refreshButton.cloneNode(true);
            refreshButton.parentNode.replaceChild(newButton, refreshButton);

            newButton.addEventListener('click', function(e) {
                console.log('Refresh completion trends button clicked');
                e.preventDefault();
                e.stopPropagation();

                // Use the dashboard.js refresh system to avoid conflicts
                if (window.refreshDashboardData && typeof window.refreshDashboardData === 'function') {
                    console.log('Using dashboard.js refresh system');
                    const filters = window.getCurrentFilters ? window.getCurrentFilters() : {};
                    window.refreshDashboardData(filters).catch(error => {
                        console.error('Dashboard refresh failed:', error);
                        // Fallback to local refresh
                        refreshCompletionTrendData();
                    });
                } else {
                    console.log('Dashboard.js not available, using local refresh');
                    refreshCompletionTrendData();
                }
                return false;
            }, true);
        } else {
            console.error('Trend refresh button not found');
        }
    }

    async function refreshCompletionTrendData() {
        console.log('Refreshing completion trend data');

        const loadingElement = document.getElementById('chart-loading');
        const chartCanvas = document.getElementById('completion-trend-chart');

        try {
            // Show loading indicator
            if (loadingElement) {
                loadingElement.style.display = 'block';
            }
            if (chartCanvas) {
                chartCanvas.style.opacity = '0.5';
            }

            // Get current filters from main dashboard
            const fromDate = document.getElementById('fromDate')?.value;
            const toDate = document.getElementById('toDate')?.value;
            const timeGranularity = document.getElementById('granularity')?.value || 'weekly';

            // Prepare request body using main filter values
            const requestBody = {
                fromDate: fromDate ? convertDateToServerFormat(fromDate) : null,
                toDate: toDate ? convertDateToServerFormat(toDate) : null,
                timeGranularity: timeGranularity,
                selectedOperatorIds: [],
                selectedProjectIds: []
            };

            console.log('Sending trend data request:', requestBody);

            // Fetch new trend data
            const headers = {
                'Content-Type': 'application/json'
            };

            const token = getAntiForgeryToken();
            if (token) {
                headers['RequestVerificationToken'] = token;
            }

            const response = await fetch('/Dashboard/GetTrendData', {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(requestBody)
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log('Received trend data:', data);

            // Handle different response structures
            let trendData = null;
            if (data.success && data.data) {
                // Check if data.data is the trend charts directly or nested
                if (data.data.trendCharts) {
                    trendData = data.data.trendCharts;
                } else if (data.data.completionTrendData) {
                    trendData = data.data;
                } else {
                    trendData = data.data;
                }
            } else if (data.completionTrendData) {
                // Direct trend data response
                trendData = data;
            }

            if (trendData && trendData.completionTrendData) {
                console.log('Using completion trend data:', trendData.completionTrendData);
                updateCompletionTrendChart(trendData.completionTrendData);
                updateTrendStats(trendData);
            } else {
                console.warn('No valid trend data found in response, using empty data');
                updateCompletionTrendChart([]);
            }

        } catch (error) {
            console.error('Error refreshing completion trend data:', error);
            updateCompletionTrendChart([]);
        } finally {
            // Hide loading indicator
            if (loadingElement) {
                loadingElement.style.display = 'none';
            }
            if (chartCanvas) {
                chartCanvas.style.opacity = '1';
            }

            // Enforce chart positioning after refresh is complete
            setTimeout(() => enforceChartPositioning(), 200);
        }
    }

    function updateCompletionTrendChart(trendData) {
        console.log('Updating completion trend chart with data:', trendData);

        // Check if chart updates are disabled due to persistent failures
        if (chartUpdateDisabled) {
            console.warn('Chart updates are disabled due to persistent failures');
            return;
        }

        // Check if dashboard.js chart system is available and has the chart
        const dashboardChart = window.charts && (window.charts.completionTrend || window.charts['completion-trend-chart']);
        if (dashboardChart) {
            console.log('Using dashboard.js chart system for update');
            try {
                // Update using dashboard.js system
                if (window.updateChart && typeof window.updateChart === 'function') {
                    window.updateChart(dashboardChart, trendData);
                    updateTrendStats(trendData);
                    return;
                } else {
                    // Direct chart update
                    const labels = trendData.map(d => d.label || d.dateFormatted || d.date || 'N/A');
                    const values = trendData.map(d => d.value || d.completionRate || 0);

                    dashboardChart.data.labels = labels;
                    dashboardChart.data.datasets[0].data = values;
                    dashboardChart.update();
                    updateTrendStats(trendData);
                    // Enforce positioning after chart update
                    setTimeout(() => enforceChartPositioning(), 100);
                    return;
                }
            } catch (error) {
                console.warn('Dashboard.js chart update failed, falling back to local update:', error);
            }
        }

        // Fallback to local chart recreation
        console.log('Recreating canvas element to avoid Chart.js conflicts');

        // Store the data for initialization
        window.pendingTrendData = trendData;

        // Destroy existing chart if it exists
        if (completionTrendChart) {
            try {
                completionTrendChart.destroy();
            } catch (e) {
                console.warn('Error destroying chart:', e);
            }
            completionTrendChart = null;
        }

        // Clear chart registry
        if (window.chartRegistry) {
            delete window.chartRegistry['completion-trend-chart'];
        }

        // Get the canvas container - specific to completion trends
        const canvasContainer = document.querySelector('.trend-charts-section .main-trend-chart .chart-container');
        if (!canvasContainer) {
            console.error('Chart container not found');
            return;
        }

        // Remove the old canvas completely
        const oldCanvas = document.getElementById('completion-trend-chart');
        if (oldCanvas) {
            oldCanvas.remove();
        }

        // Create a completely new canvas element
        const newCanvas = document.createElement('canvas');
        newCanvas.id = 'completion-trend-chart';
        newCanvas.width = 800;
        newCanvas.height = 360;
        newCanvas.setAttribute('data-chart-type', 'completion-trend');

        // Set explicit CSS styles to ensure proper positioning and sizing with !important
        newCanvas.style.setProperty('width', '100%', 'important');
        newCanvas.style.setProperty('height', '360px', 'important');
        newCanvas.style.setProperty('max-width', '100%', 'important');
        newCanvas.style.setProperty('display', 'block', 'important');
        newCanvas.style.setProperty('position', 'relative', 'important');
        newCanvas.style.setProperty('top', '0', 'important');
        newCanvas.style.setProperty('left', '0', 'important');
        newCanvas.style.setProperty('margin', '0', 'important');
        newCanvas.style.setProperty('padding', '0', 'important');
        newCanvas.style.setProperty('z-index', '1', 'important');
        newCanvas.style.setProperty('visibility', 'visible', 'important');
        newCanvas.style.setProperty('opacity', '1', 'important');

        // Ensure container has proper styling to contain the chart
        canvasContainer.style.position = 'relative';
        canvasContainer.style.width = '100%';
        canvasContainer.style.height = '400px';
        canvasContainer.style.overflow = 'visible';
        canvasContainer.style.display = 'block';

        // Add the new canvas to the container
        canvasContainer.appendChild(newCanvas);

        // Recreate the chart with new data after a delay
        setTimeout(() => {
            initializeCompletionTrendChart();
            // Ensure positioning is enforced after chart creation
            enforceChartPositioning();
        }, 100);

        return;
    }

    function updateTrendStats(trendData) {
        console.log('Updating trend stats with data:', trendData);

        try {
            // Update the stats in the overview section
            if (trendData && trendData.completionTrendData && Array.isArray(trendData.completionTrendData) && trendData.completionTrendData.length > 0) {
                const completionData = trendData.completionTrendData;
                const currentRate = completionData[completionData.length - 1]?.value || 0;
                const avgRate = completionData.reduce((sum, d) => sum + (d?.value || 0), 0) / completionData.length;

                // Update current rate display in the third stat card
                const currentRateElements = document.querySelectorAll('.trend-stat .stat-value');
                if (currentRateElements.length >= 3) {
                    const currentRateElement = currentRateElements[2]; // Third stat card
                    if (currentRateElement) {
                        currentRateElement.textContent = currentRate.toFixed(1) + '%';
                    }
                }

                // Update summary cards if they exist
                const summaryValues = document.querySelectorAll('.summary-card .summary-item .value');
                summaryValues.forEach((element, index) => {
                    if (element && element.textContent.includes('%')) {
                        switch (index) {
                            case 0: // Current Period
                                element.textContent = currentRate.toFixed(1) + '%';
                                break;
                            case 2: // Average Rate
                                element.textContent = avgRate.toFixed(1) + '%';
                                break;
                        }
                    }
                });

                console.log('Trend stats updated successfully');
            } else {
                console.warn('No valid completion trend data for stats update');
            }
        } catch (error) {
            console.error('Error updating trend stats:', error);
        }
    }

    // Helper functions
    function convertDateToServerFormat(dateString) {
        if (!dateString) return null;

        try {
            // Convert from dd/MM/yyyy to yyyy-MM-dd
            const parts = dateString.split('/');
            if (parts.length === 3) {
                return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
            }
            return dateString;
        } catch (error) {
            console.warn('Error converting date format:', error);
            return dateString;
        }
    }

    function enforceChartPositioning() {
        console.log('Enforcing chart positioning...');

        const container = document.querySelector('.trend-charts-section .main-trend-chart .chart-container');
        const canvas = document.getElementById('completion-trend-chart');

        if (container) {
            console.log('Container found, applying styles...');
            container.style.setProperty('position', 'relative', 'important');
            container.style.setProperty('width', '100%', 'important');
            container.style.setProperty('height', '400px', 'important');
            container.style.setProperty('overflow', 'visible', 'important');
            container.style.setProperty('display', 'block', 'important');
            container.style.setProperty('margin', '0', 'important');
            container.style.setProperty('padding', '20px', 'important');
            container.style.setProperty('background', 'white', 'important');
            container.style.setProperty('border-radius', '8px', 'important');
            container.style.setProperty('border', '1px solid #e9ecef', 'important');
            console.log('Container styles applied. Height:', container.style.height, 'Computed height:', window.getComputedStyle(container).height);
        } else {
            console.error('Container not found!');
        }

        if (canvas) {
            console.log('Canvas found, applying styles...');
            canvas.style.setProperty('position', 'relative', 'important');
            canvas.style.setProperty('top', '0', 'important');
            canvas.style.setProperty('left', '0', 'important');
            canvas.style.setProperty('width', '100%', 'important');
            canvas.style.setProperty('height', '360px', 'important'); // Slightly less than container to account for padding
            canvas.style.setProperty('max-width', '100%', 'important');
            canvas.style.setProperty('display', 'block', 'important');
            canvas.style.setProperty('margin', '0', 'important');
            canvas.style.setProperty('padding', '0', 'important');
            canvas.style.setProperty('z-index', '1', 'important');
            canvas.style.setProperty('visibility', 'visible', 'important');
            canvas.style.setProperty('opacity', '1', 'important');

            // Set canvas attributes for proper rendering
            canvas.setAttribute('width', '800');
            canvas.setAttribute('height', '360');

            console.log('Canvas styles applied. Width:', canvas.style.width, 'Height:', canvas.style.height);
            console.log('Canvas computed styles:', window.getComputedStyle(canvas).width, 'x', window.getComputedStyle(canvas).height);
            console.log('Canvas attributes:', canvas.width, 'x', canvas.height);
        } else {
            console.error('Canvas not found!');
        }

        console.log('Chart positioning enforced');

        // Debug: Check final positioning
        setTimeout(() => {
            debugChartVisibility();
        }, 100);
    }

    function debugChartVisibility() {
        console.log('=== CHART VISIBILITY DEBUG ===');
        const container = document.querySelector('.trend-charts-section .main-trend-chart .chart-container');
        const canvas = document.getElementById('completion-trend-chart');

        if (container) {
            const containerRect = container.getBoundingClientRect();
            const containerStyles = window.getComputedStyle(container);
            console.log('Container position:', {
                top: containerRect.top,
                left: containerRect.left,
                width: containerRect.width,
                height: containerRect.height,
                computedHeight: containerStyles.height,
                computedWidth: containerStyles.width,
                display: containerStyles.display,
                visibility: containerStyles.visibility,
                opacity: containerStyles.opacity
            });
        }

        if (canvas) {
            const canvasRect = canvas.getBoundingClientRect();
            const canvasStyles = window.getComputedStyle(canvas);
            console.log('Canvas position:', {
                top: canvasRect.top,
                left: canvasRect.left,
                width: canvasRect.width,
                height: canvasRect.height,
                computedHeight: canvasStyles.height,
                computedWidth: canvasStyles.width,
                display: canvasStyles.display,
                visibility: canvasStyles.visibility,
                opacity: canvasStyles.opacity,
                attributes: { width: canvas.width, height: canvas.height }
            });

            // Check if canvas is in viewport
            const isInViewport = canvasRect.top >= 0 && canvasRect.left >= 0 &&
                               canvasRect.bottom <= window.innerHeight &&
                               canvasRect.right <= window.innerWidth;
            console.log('Canvas in viewport:', isInViewport);

            // Check if canvas has Chart.js instance
            console.log('Canvas has chart instance:', !!canvas.chart);
        }
        console.log('=== END DEBUG ===');
    }

    function getAntiForgeryToken() {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            return token ? token.value : "";
        } catch (error) {
            console.warn('Could not get anti-forgery token:', error);
            return "";
        }
    }
</script>

