@model PerformanceDashboardModel
@{
    ViewData["Title"] = "Performance Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.css" />
}

@Html.AntiForgeryToken()

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">
                <svg width="24" height="24" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                    <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                </svg>
                Performance Dashboard
            </h1>
            <p class="dashboard-subtitle">Analytics and insights for task performance and team productivity</p>
        </div>
        
        <!-- Filter Controls -->
        <div class="filter-controls">
            <form id="dashboard-filters" class="filters-form">
                <div class="filter-group">
                    <label for="fromDate" class="filter-label">From Date:</label>
                    <input type="date" id="fromDate" name="fromDate" class="filter-input"
                           value="@Model.AppliedFilters?.FromDate?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <label for="toDate" class="filter-label">To Date:</label>
                    <input type="date" id="toDate" name="toDate" class="filter-input"
                           value="@Model.AppliedFilters?.ToDate?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <label for="granularity" class="filter-label">Time Period:</label>
                    <select id="granularity" name="granularity" class="filter-select">
                        <option value="daily" selected="@(Model.AppliedFilters?.TimeGranularity == "daily")">Daily</option>
                        <option value="weekly" selected="@(Model.AppliedFilters?.TimeGranularity == "weekly")">Weekly</option>
                        <option value="monthly" selected="@(Model.AppliedFilters?.TimeGranularity == "monthly")">Monthly</option>
                    </select>
                </div>
                
                <div class="filter-actions">
                    <button type="button" id="apply-filters" class="btn btn-primary">
                        <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                        Apply Filters
                    </button>
                    <button type="button" id="refresh-data" class="btn btn-secondary">
                        <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                        </svg>
                        Refresh
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="loading-indicator" class="loading-indicator" style="display: none;">
        <div class="spinner"></div>
        <span>Loading dashboard data...</span>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboard-content" class="dashboard-content">
        @if (Model != null)
        {
            <!-- KPI Summary Cards -->
            <div class="kpi-summary">
                <div class="kpi-card">
                    <div class="kpi-icon efficiency">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <h3 class="kpi-value">@(Model.EfficiencyMetrics?.OnTimeCompletionRate.ToString("F1") ?? "0.0")%</h3>
                        <p class="kpi-label">On-Time Completion</p>
                        @if (Model.EfficiencyMetrics != null)
                        {
                            <span class="kpi-trend @(Model.EfficiencyMetrics.EfficiencyTrend >= 0 ? "positive" : "negative")">
                                @(Model.EfficiencyMetrics.EfficiencyTrend >= 0 ? "↗" : "↘") @Math.Abs(Model.EfficiencyMetrics.EfficiencyTrend).ToString("F1")%
                            </span>
                        }
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon tasks">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5V5zM6.5 7.5A.5.5 0 0 1 7 7h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H7a.5.5 0 0 1-.5-.5v-1zM6 10.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <h3 class="kpi-value">@(Model.TotalTasksAnalyzed)</h3>
                        <p class="kpi-label">Tasks Analyzed</p>
                        <span class="kpi-period">@Model.AnalysisPeriod</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon operators">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <h3 class="kpi-value">@(Model.TotalOperatorsAnalyzed)</h3>
                        <p class="kpi-label">Active Operators</p>
                        <span class="kpi-period">Performance Tracked</span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon overrun">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1.001.025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z"/>
                            <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z"/>
                            <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z"/>
                        </svg>
                    </div>
                    <div class="kpi-content">
                        <h3 class="kpi-value">@(Model.EfficiencyMetrics?.AverageTimeOverrunPercentage.ToString("F1") ?? "0.0")%</h3>
                        <p class="kpi-label">Avg Time Overrun</p>
                        <span class="kpi-period">Above Estimates</span>
                    </div>
                </div>
            </div>

            <!-- Main Dashboard Grid -->
            <div class="dashboard-grid">
                <!-- Efficiency Metrics Section -->
                <div class="dashboard-section efficiency-section">
                    <div class="section-header">
                        <h2 class="section-title">Efficiency Metrics</h2>
                        <button type="button" class="btn-icon" id="refresh-efficiency" title="Refresh Efficiency Data">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="section-content">
                        @await Html.PartialAsync("Partials/_EfficiencyMetrics", Model.EfficiencyMetrics)
                    </div>
                </div>

                <!-- Operator Performance Section -->
                <div class="dashboard-section operator-section">
                    <div class="section-header">
                        <h2 class="section-title">Operator Performance</h2>
                        <div class="section-controls">
                            <select id="operator-sort" class="control-select">
                                <option value="efficiency">Sort by Efficiency</option>
                                <option value="tasks">Sort by Tasks</option>
                                <option value="hours">Sort by Hours</option>
                                <option value="name">Sort by Name</option>
                            </select>
                            <button type="button" class="btn-icon" id="refresh-operators" title="Refresh Operator Data">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="section-content">
                        @await Html.PartialAsync("Partials/_OperatorPerformance", Model.OperatorPerformance)
                    </div>
                </div>

                <!-- Bottleneck Analysis Section -->
                <div class="dashboard-section bottleneck-section">
                    <div class="section-header">
                        <h2 class="section-title">Bottleneck Analysis</h2>
                        <button type="button" class="btn-icon" id="refresh-bottlenecks" title="Refresh Bottleneck Data">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="section-content">
                        @await Html.PartialAsync("Partials/_BottleneckAnalysis", Model.BottleneckAnalysis)
                    </div>
                </div>

                <!-- Trend Charts Section -->
                <div class="dashboard-section trends-section">
                    <div class="section-header">
                        <h2 class="section-title">Completion Trends</h2>
                        <button type="button" class="btn-icon" id="refresh-trends" title="Refresh Trend Data">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="section-content">
                        @await Html.PartialAsync("Partials/_TrendCharts", Model.TrendCharts)
                    </div>
                </div>
            </div>

            <!-- Export Actions (Admin Only) -->
            @if (User?.IsAdmin() == true)
            {
                <div class="export-actions">
                    <h3 class="export-title">Export Reports</h3>
                    <div class="export-buttons">
                        <button type="button" id="export-pdf" class="btn btn-outline-primary">
                            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                                <path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.697 19.697 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a10.954 10.954 0 0 0 .98 1.686 5.753 5.753 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.856.856 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.712 5.712 0 0 1-.911-.95 11.651 11.651 0 0 0-1.997.406 11.307 11.307 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.793.793 0 0 1-.58.029zm1.379-1.901c-.166.076-.32.156-.459.238-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361.01.022.02.036.026.044a.266.266 0 0 0 .035-.012c.137-.056.355-.235.635-.572a8.18 8.18 0 0 0 .45-.606zm1.64-1.33a12.71 12.71 0 0 1 1.01-.193 11.744 11.744 0 0 1-.51-.858 20.801 20.801 0 0 1-.5 1.05zm2.446.45c.15.163.296.3.435.41.24.19.407.253.498.256a.107.107 0 0 0 .07-.015.307.307 0 0 0 .094-.125.436.436 0 0 0 .059-.2.095.095 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a3.876 3.876 0 0 0-.612-.053zM8.078 7.8a6.7 6.7 0 0 0 .2-.828c.031-.188.043-.343.038-.465a.613.613 0 0 0-.032-.198.517.517 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822.024.111.054.227.09.346z"/>
                            </svg>
                            Export PDF
                        </button>
                        <button type="button" id="export-excel" class="btn btn-outline-success">
                            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                                <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219l-2.116-2.54z"/>
                                <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/>
                            </svg>
                            Export Excel
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <svg width="64" height="64" fill="currentColor" class="empty-icon" viewBox="0 0 16 16">
                    <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                </svg>
                <h3>No Dashboard Data Available</h3>
                <p>Unable to load dashboard data. Please try refreshing the page or adjusting your filters.</p>
                <button type="button" id="retry-load" class="btn btn-primary">Retry Loading</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
